# The release stage copies only the files it needs. These rules keep the
# build context small and keep local files out of every stage.
.env
node_modules
.idea
.claude
data
stacks
tmp
/private
.git
.github
test
docker
CLAUDE.md
CHANGELOG.md
README.md
SECURITY.md

# The frontend_build stage compiles frontend/ inside the image. A stale local
# build must not shadow that output.
frontend-dist
# The build_healthcheck stage compiles this binary for the target platform.
extra/healthcheck
